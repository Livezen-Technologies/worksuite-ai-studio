[Unit]
Description=AI Studio ML service (text classifiers)
After=network.target

[Service]
User=www-data
Group=www-data
Environment=ML_ROOT=/srv/aistudio-models/ml
Environment=ML_THREADS=4
Environment=HF_HOME=/srv/aistudio-hf
ExecStart=/opt/aistudio-llm/venv/bin/python /var/www/ollamahub/deploy/ml/ml_service.py
Restart=always
RestartSec=5
Nice=5
# Sandboxing: no privilege escalation, read-only /usr /boot /etc, kernel settings off-limits.
NoNewPrivileges=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
