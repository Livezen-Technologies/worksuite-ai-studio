# OllamaHub — production .env (copy to /var/www/ollamahub/.env on the server and fill in).
CI_ENVIRONMENT = production

app.baseURL = 'http://40.160.57.17/'   # change to https://your-domain/ after SSL
app.forceGlobalSecureRequests = false  # set true once HTTPS is live
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = ollamahub
database.default.username = ollamahub
database.default.password = CHANGE_ME_STRONG
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# 64-char random secret — generate with: openssl rand -hex 32
JWT_SECRET = CHANGE_ME_64_HEX

ollama.timeout = 300
prometheus.baseURL = 'http://127.0.0.1:9090'

security.csrfProtection = 'cookie'
security.tokenRandomize = true
