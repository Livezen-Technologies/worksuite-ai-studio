# WorkSuite AI Studio — production .env (copy to /var/www/ollamahub/.env on the server and fill in).
CI_ENVIRONMENT = production

app.baseURL = 'https://aistudio.example.com/'   # your domain (HTTPS)
app.forceGlobalSecureRequests = false  # set true once HTTPS is live
app.indexPage = ''

database.default.hostname = 127.0.0.1
database.default.database = ollamahub
database.default.username = ollamahub
database.default.password = CHANGE_ME_STRONG
database.default.DBDriver = MySQLi
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

# 64-char random secret — generate with: openssl rand -hex 32
JWT_SECRET = CHANGE_ME_64_HEX

ollama.timeout = 300
prometheus.baseURL = 'http://127.0.0.1:9090'

security.csrfProtection = 'cookie'
security.tokenRandomize = true

# Sinhala AI Engine package signing (base64 Ed25519 secret key; see docs/sinhala-ai-engine/IMPLEMENTATION.md)
# ENGINE_SIGNING_SECRET=

# Sign in with WorkSuite Cloud (staff SSO; see docs/runbook.md "WorkSuite Cloud sign-in"). Off unless the
# four WSC_OIDC_* lines are set. Phase B: WSC_OIDC_ISSUER=https://auth.worksuitecloud.com is the move switch.
# WSC_OIDC_ISSUER = https://account.worksuitecloud.com/oauth
# WSC_OIDC_CLIENT_ID = staff-aistudio
# WSC_OIDC_CLIENT_SECRET =
# WSC_OIDC_REDIRECT_URI = https://aistudio.worksuitecloud.com/api/auth/wsc/callback
# WSC_OIDC_ACCEPTED_ISSUERS = https://account.worksuitecloud.com/oauth,https://auth.worksuitecloud.com
# WSC_SSO_POLICY = oneauth_optional
# WSC_SSO_BREAKGLASS =
