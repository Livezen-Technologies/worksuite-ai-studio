# Base URL of your AI Studio install (no trailing /api).
AISTUDIO_URL=https://aistudio.example.com

# Sign-in for the account the MCP server acts as. Use a dedicated service user with
# only the role/permissions you want Claude/ChatGPT to have.
AISTUDIO_EMAIL=mcp-bot@example.com
AISTUDIO_PASSWORD=change-me
# Only if that user has two-factor sign-in on: the base32 TOTP secret (from Account -> Security setup).
AISTUDIO_TOTP_SECRET=

# Alternative to email/password: a refresh token (valid 14 days, from a signed-in browser's
# localStorage key "aistudio.refresh").
AISTUDIO_REFRESH_TOKEN=

# Set to true to expose read-only tools only (no create/update/delete/control).
AISTUDIO_MCP_READ_ONLY=false

# --- Remote (HTTP) mode only: `npm run start:http` ---
PORT=8787
# Interface to listen on. Default 127.0.0.1 (nginx proxies to 127.0.0.1:8787); use 0.0.0.0 only
# if clients connect directly and a firewall restricts who can.
HOST=127.0.0.1
# Set when behind a reverse proxy so rate limits use the real client IP from X-Forwarded-For
# (Express "trust proxy": loopback, a hop count like 1, or a subnet list). Leave empty otherwise.
TRUST_PROXY=
# Required in HTTP mode. Long random string (openssl rand -hex 32); clients send it as
# "Authorization: Bearer <secret>". For one secret per client, list them in MCP_AUTH_SECRETS
# (comma-separated) so each can be revoked on its own.
MCP_AUTH_SECRET=
MCP_AUTH_SECRETS=
# Allow https://host/mcp/<secret> for connectors that cannot send headers (claude.ai, ChatGPT).
# The secret then appears in URLs: turn access logging off for /mcp on your proxy.
MCP_ALLOW_URL_SECRET=false
