# Base URL of your AI Studio install (no trailing /api).
AISTUDIO_URL=https://aistudio.example.com

# Sign-in for the account the MCP server acts as. Use a dedicated service user with
# only the role/permissions you want Claude/ChatGPT to have.
AISTUDIO_EMAIL=mcp-bot@example.com
AISTUDIO_PASSWORD=change-me
# Only if that user has two-factor sign-in on: the base32 TOTP secret (from Account -> Security setup).
AISTUDIO_TOTP_SECRET=

# Alternative to email/password: a refresh token (valid 14 days, from a signed-in browser's
# localStorage key "aistudio.refresh").
AISTUDIO_REFRESH_TOKEN=

# Set to true to expose read-only tools only (no create/update/delete/control).
AISTUDIO_MCP_READ_ONLY=false

# --- Remote (HTTP) mode only: `npm run start:http` ---
PORT=8787
# Required in HTTP mode. Long random string; clients send it as "Authorization: Bearer <secret>"
# or use the URL https://host/mcp/<secret> (for connectors that cannot send headers).
MCP_AUTH_SECRET=
